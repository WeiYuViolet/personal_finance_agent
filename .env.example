# ===== 复制本文件为 .env 并填入真实配置 =====

# 大模型选择：DeepSeek / OpenAI / 任意 OpenAI 兼容接口 / 本地 Ollama 均可
# DeepSeek 示例（https://platform.deepseek.com 申请密钥）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TEMPERATURE=0.3

# OpenAI 示例（取消注释替换上面三行）
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxx

# 本地 Ollama 示例
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1

# ===== 应用配置 =====
# 是否在首次启动时为 default 用户写入演示账单（1=是，0=否）
SEED_DEMO_DATA=1
# Gradio 端口
APP_PORT=7860
